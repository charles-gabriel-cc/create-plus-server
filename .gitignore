# Ignore runtime, world saves, caches, and local user files
/*
!/mods/
!/server-mods/
!/resourcepacks/
!/shaderpacks/
!/config/
!/scripts/
!/.github/
!/.gitignore
!/README.md
!/sincronizar-github.bat

# Ignore disabled mods and connector cache inside mods/
/mods/.connector/
/mods/*.disabled
/mods/*.tmp
/mods/*.bak

# Ignore local backups and Xaero client settings
/config/*.bak
/config/xaero/
/config/xaerohud.txt
/config/xaeropatreon.txt
