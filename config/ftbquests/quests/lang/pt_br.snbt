	quest.3000000000000056.title: "Monitor de radar"
	quest.3000000000000057.quest_desc: [ "Conecte seu radar ao canhao usando &bAuto-Pitch&r, &bAuto-Yaw&r e &bFire Controller&r para calcular balistica e travar mira automaticamente!" ]
