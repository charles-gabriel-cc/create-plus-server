	quest.300000000000003F.title: "Eletricidade: Power Grid"
	quest.3000000000000040.quest_desc: [ "Acione um Gerador multi-bloco com moinho/vapor/diesel e leve energia por cabos a distancia ate Motores Eletricos!" ]
	quest.3000000000000040.quest_subtitle: "Converta rotacao (SU) em energia eletrica e vice-versa"
	quest.3000000000000040.title: "Geradores Eletricos \\& Motores"
	quest.3000000000000041.quest_desc: [ "Confira tensão e conexões com o multímetro. A bateria armazena energia para quando o gerador parar." ]
	quest.3000000000000041.quest_subtitle: "Multímetro e bateria"
	quest.3000000000000041.title: "Meça e armazene eletricidade"
	quest.3000000000000042.quest_desc: [ "Desenhe circuitos integrados personalizados na &bCircuit Design Table&r e use ferramentas portateis recarregaveis." ]
