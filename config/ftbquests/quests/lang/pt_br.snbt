	quest.3FCCC2CC293CC695.title: "Alex's Mobs Continued"
	quest.3FD034A02AE5EEDF.quest_desc: [ "Complete o encontro do labirinto e pegue o tesouro no baú da sala." ]
	quest.3FD034A02AE5EEDF.quest_subtitle: "Encontro opcional"
	quest.3FD034A02AE5EEDF.title: "Eldritch Warden"
	quest.3FE3351DA2B322E2.quest_desc: [ "Procure o trono na savana. Em combate, lide com os seguidores que curam o chefe. A vitória rende Sol Visage." ]
	quest.3FE3351DA2B322E2.quest_subtitle: "Encontro opcional"
	quest.3FE3351DA2B322E2.title: "Umvuthi"
	quest.3FE5E0B02C1A503F.quest_desc: [ "Encontre a forja no Nether. A luta rende Infernal Forge, Monstrous Horn e Lava Power Cells." ]
	quest.3FE5E0B02C1A503F.quest_subtitle: "Encontro opcional"
	quest.3FE5E0B02C1A503F.title: "Netherite Monstrosity"
	quest.3FE6568846BE23B6.quest_desc: [ "Derrote a forma verdadeira para obter Lifestealer Bones e Dark Metal." ]
	quest.3FE6568846BE23B6.quest_subtitle: "Encontro opcional"
	quest.3FE6568846BE23B6.title: "Lifestealer"
	quest.3FED7AF4E4F0C024.quest_desc: [ "Obtenha três crânios de esqueleto Wither e quatro blocos de areia ou terra das almas. A vitória rende uma Nether Star." ]
	quest.3FED7AF4E4F0C024.quest_subtitle: "Encontro opcional"
	quest.3FED7AF4E4F0C024.title: "Wither"
	quest.3FEF4628C26FC039.quest_desc: [ "Oriente os Mechanical Crafters em direção à saída. Monte a grade do tamanho da receita, preencha os espaços vazios com tampas e alimente a rede com rotação." ]
	quest.3FEF4628C26FC039.quest_subtitle: "Monte sua bancada de crafters"
	quest.3FEF4628C26FC039.title: "Montagem mecânica"
	quest.3FF01B18FD88D9F1.quest_desc: [ "A luta na água rende Raw Tentacle e Comically Large Nautilus Shell." ]
	quest.3FF01B18FD88D9F1.quest_subtitle: "Encontro opcional"
	quest.3FF01B18FD88D9F1.title: "Shell Beast"
	quest.3FF605CEECF3BC6E.quest_desc: [ "Encontre o Revenant no Nether e guarde Burning Ashes para invocar Ignis." ]
	quest.3FF605CEECF3BC6E.quest_subtitle: "Encontro opcional"
	quest.3FF605CEECF3BC6E.title: "Ignited Revenant"
