	quest.3000000000000042.title: "Ferramentas Eletricas \\& Placas PCB"
	quest.3000000000000043.quest_desc: [ "Confira o tipo de processamento de cada liga no EMI. Use as primeiras barras em chapas, peças e ferramentas quando precisar delas." ]
	quest.3000000000000043.quest_subtitle: "Primeiras ligas do Alloyed"
	quest.3000000000000043.title: "Ligas de aço e bronze"
	quest.3000000000000044.quest_desc: [ "Use a Mechanical Grindstone para recuperar experiência. A Experience Hatch conecta o XP armazenado ao sistema. Equipamentos de encantamento são a expansão dessa linha." ]
	quest.3000000000000044.quest_subtitle: "Moagem e armazenamento de XP"
	quest.3000000000000044.title: "Automatize experiência"
	quest.3000000000000045.quest_desc: [ "Conecte a Fluid Hatch a um tanque. O Dragão do End é uma fonte de Bafo de Dragão, que você pode coletar em frascos durante a luta." ]
	quest.3000000000000045.quest_subtitle: "Hatch e tanque do Dragons Plus"
	quest.3000000000000045.title: "Transfira fluidos especiais"
	quest.3000000000000046.quest_desc: [ "Teste o queimador ajustável e o envelope em uma montagem pequena. A hélice de andesito dá empuxo. Use o Ponder para montar e controlar a estrutura." ]
	quest.3000000000000046.quest_subtitle: "Propulsão e sustentação"
	quest.3000000000000046.title: "Sua primeira aeronave"
	quest.3000000000000047.quest_desc: [ "Oriente a hélice com o rolamento giroscópico. Use lastro e envelopes adicionais quando precisar equilibrar o veículo." ]
	quest.3000000000000047.quest_subtitle: "Rolamento giroscópico"
	quest.3000000000000047.title: "Voo estável"
	quest.3000000000000048.quest_desc: [ "Ligue a mesa de controle a um joystick. Use servos e giroscópio conforme a aeronave precisar." ]
	quest.3000000000000048.quest_subtitle: "Mesa de controle e joystick"
	quest.3000000000000048.title: "Controles de voo"
	quest.3000000000000049.quest_desc: [ "Faça o Flight Control Computer em uma linha de montagem e conecte o Altitude Hold. Teste em baixa altura antes de expandir o sistema." ]
	quest.3000000000000049.quest_subtitle: "Computador e controle de altitude"
	quest.3000000000000049.title: "Assistência de voo"
	quest.300000000000004A.quest_desc: [ "Use a ferramenta numa seção pequena da aeronave. Juntas, cilindros e amortecedores são peças para montagens mais complexas." ]
	quest.300000000000004A.quest_subtitle: "Magnetic Gun"
	quest.300000000000004A.title: "Montagem magnética"
	quest.300000000000004B.quest_desc: [ "Use chapas resistentes, mecanismos de precisão e sensores nas receitas. Teste os propulsores em uma estrutura experimental." ]
	quest.300000000000004B.quest_subtitle: "Propulsores iônico e vetorial"
	quest.300000000000004B.title: "Propulsão avançada"
	quest.300000000000004C.quest_desc: [ "Inspecione o estado da contraption pelo Diagnostic Tablet antes de ajustar o controlador avançado." ]
