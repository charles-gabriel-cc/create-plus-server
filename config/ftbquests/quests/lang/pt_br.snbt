	quest.3000000000000054.title: "Projétil e carga"
	quest.3000000000000055.quest_desc: [ "Gire a antena com energia cinetica sobre um &bRadar Bearing&r para detectar aeronaves, trens, jogadores e entidades a centenas de blocos!" ]
