	quest.3000000000000052.title: "Construtor \\& Furadeira de Canhoes"
	quest.3000000000000053.quest_desc: [ "Funda o cano e usine-o com a Cannon Drill. Prenda-o à base e use o Ponder para montar, apontar e carregar o canhão." ]
