	quest.3000000000000050.title: "Motor Sable \\& Voo de Aileron (Elytra)"
	quest.3000000000000051.quest_desc: [ "Aqueça a fundição e comece por peças de ferro fundido. Reserve Nethersteel para as peças avançadas." ]
