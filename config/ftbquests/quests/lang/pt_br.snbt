{
	chapter.2000000000000001.chapter_subtitle: [ "Guia inicial, mochilas, proteção de terreno, mapas e qualidade de vida no Create+." ]
	chapter.2000000000000001.title: "Primeiros Passos \\& Sobrevivência"
	chapter.2000000000000002.chapter_subtitle: [ "Use rotação para prensar sua primeira chapa e monte uma oficina que se abastece pela esteira." ]
	chapter.2000000000000002.title: "Create: Era do Andesito"
	chapter.2000000000000003.chapter_subtitle: [ "Mecanismos de precisao, caldeiras a vapor, ferrovias e a rede completa de pacotes do Create 6.0." ]
	chapter.2000000000000003.title: "Create: Era do Latão, Trens \\& Logística 6.0"
	chapter.2000000000000004.chapter_subtitle: [ "Steam 'n' Rails, Navegador, Montanhas-Russas, Circuitos, Gauges, Pocket Sized e Chunk Loaders." ]
	chapter.2000000000000004.title: "Addons: Ferrovias, Circuitos \\& Utilitários"
	chapter.2000000000000005.chapter_subtitle: [ "Petroleo, motores a diesel, geradores eletricos do Power Grid, ligas de Aco e industria de encantamentos." ]
	chapter.2000000000000005.title: "Indústria Pesada: Diesel, Eletricidade, Aço \\& XP"
	chapter.2000000000000006.chapter_subtitle: [ "Dirigiveis, avioes, carros off-road, mechas caminhantes, propulsores espaciais e o motor Sable." ]
	chapter.2000000000000006.title: "Aeronáutica, Veículos \\& Física Real"
	chapter.2000000000000007.chapter_subtitle: [ "Create Big Cannons \\& Create: Radars — Fundicao de canhoes, municoes balisticas e torres guiadas por radar." ]
	chapter.2000000000000007.title: "Artilharia Pesada \\& Radares"
	chapter.2000000000000008.chapter_subtitle: [ "Fogoes, panelas, cutelaria, solo rico, pratos do Nether/Cavernas/End e automacao com Create." ]
	chapter.2000000000000008.title: "Gastronomia \\& Fazendas (Farmer's Delight)"
	chapter.2000000000000009.chapter_subtitle: [ "Copycats+, Quark, Supplementaries, Moveis, Iluminacao, Bricks e o sistema monetario Numismatics." ]
	chapter.2000000000000009.title: "Arquitetura, Decoração \\& Economia"
	chapter.200000000000000A.chapter_subtitle: [ "Terralith, Tectonic, Ecologics, Friends\\&Foes e todas as 10 super-estruturas do YUNG!" ]
	chapter.200000000000000A.title: "Exploração, Dimensões \\& Estruturas"
	chapter.200000000000000B.chapter_subtitle: [ "Referência opcional sobre os mods e componentes do Create+." ]
	chapter.200000000000000B.title: "Catálogo de Mods · Parte 1"
	chapter.200000000000000C.chapter_subtitle: [ "Referência opcional sobre os mods e componentes do Create+." ]
	chapter.200000000000000C.title: "Catálogo de Mods · Parte 2"
	chapter.200000000000000D.chapter_subtitle: [ "Acompanhe os encontros de cada região e descubra suas recompensas." ]
	chapter.200000000000000D.title: "Chefes \\& Expedições"
	chapter_group.1000000000000001.title: "Início \\& Sobrevivência"
	chapter_group.1000000000000002.title: "Engenharia Create"
	chapter_group.1000000000000003.title: "Aeronáutica, Física \\& Combate"
	chapter_group.1000000000000004.title: "Gastronomia, Construção \\& Mundo"
	chapter_group.1000000000000005.title: "Referência do Modpack"
	file.0000000000000001.title: "Create+ | Livro de Quests"
	quest.3000000000000001.quest_desc: [
		"Comece pela sobrevivência e pelos primeiros mecanismos do Create. As linhas entre as quests indicam o que abre o próximo passo."
		"Use &e[R]&r no EMI para ver uma receita e &e[U]&r para ver os usos do item. Nas peças do Create, segure &e[W]&r para abrir o Ponder."
		"Use &e/ftbteams&r para jogar com progresso compartilhado. As trilhas de culinária, construção e chefes podem ser feitas em paralelo."
	]
	quest.3000000000000001.quest_subtitle: "Seu guia completo do modpack"
	quest.3000000000000001.title: "Bem-vindo ao Create+!"
	quest.3000000000000002.quest_desc: [
		"Nunca mais falte espaco na mineracao!"
		"A mochila do &bSophisticated Backpacks&r pode ser equipada no slot de costas ou colocada no chao (Shift + Botao Direito)."
		"Ela aceita varios modulos internos (upgrades): imas de itens, alimentacao automatica, mesa de craft e compactacao!"
	]
	quest.3000000000000002.quest_subtitle: "Sophisticated Backpacks — Espaco portatil"
	quest.3000000000000002.title: "Mochila de Aventureiro"
	quest.3000000000000003.quest_desc: [ "Melhora os slots de inventario e adiciona espaco para mais upgrades internos." ]
	quest.3000000000000003.quest_subtitle: "Upgrade de capacidade Tier 2"
	quest.3000000000000003.title: "Mochila de Ferro"
	quest.3000000000000004.quest_desc: [ "Mais espaco ainda para longas expedicoes e obras com o Create." ]
	quest.3000000000000004.quest_subtitle: "Upgrade de capacidade Tier 3"
	quest.3000000000000004.title: "Mochila de Ouro"
	quest.3000000000000005.quest_desc: [ "Quase um bau duplo inteiro nas costas, com multiplos slots de upgrades." ]
	quest.3000000000000005.quest_subtitle: "Upgrade de capacidade Tier 4"
	quest.3000000000000005.title: "Mochila de Diamante"
	quest.3000000000000006.quest_desc: [ "Nao queima na lava e oferece armazenamento portatil absurdo!" ]
	quest.3000000000000006.quest_subtitle: "A prova de lava — Capacidade maxima"
	quest.3000000000000006.title: "Mochila de Netherite"
	quest.3000000000000007.quest_desc: [ "Instale Pickup Upgrade para recolher itens na mochila ou Feeding Upgrade para comer automaticamente. Magnet e Compacting são opções para depois." ]
	quest.3000000000000007.quest_subtitle: "Coleta automática e alimentação"
	quest.3000000000000007.title: "Melhore sua mochila"
	quest.3000000000000008.quest_desc: [ "Com um clique (Shift + Botao Direito no bau), descarrega da mochila tudo que combina com o bau!" ]
	quest.3000000000000008.quest_subtitle: "Sophisticated Backpacks — Deposit Upgrade"
	quest.3000000000000008.title: "Deposito Rapido em Baus"
	quest.3000000000000009.quest_desc: [
		"O &bMap Atlases&r reune dezenas de mapas em um unico livro."
		"Basta carregar mapas vazios na mochila ou no Atlas para ir revelando a regiao ao caminhar!"
	]
	quest.3000000000000009.quest_subtitle: "Map Atlases — Navegacao estilosa"
	quest.3000000000000009.title: "Atlas de Mapas"
	quest.300000000000000A.quest_desc: [ "Em estruturas, baús do Lootr geram um inventário para cada jogador. Marque após abrir o primeiro." ]
	quest.300000000000000A.quest_subtitle: "Tesouros em estruturas"
	quest.300000000000000A.title: "Baús individuais do Lootr"
	quest.300000000000000B.quest_desc: [
		"Proteja suas fabricas contra explosoes, griefers e crie grupos com seus amigos:"
		"- Use os comandos &e/openpac-parties&r ou o atalho do menu para criar sua Party e convidar amigos."
		"- No menu de Claims (ou tecla de atalho configurada em Controles), clique com o mouse nos chunks da sua base para protege-los."
		"- Voce tambem pode dar forceload em chunks importantes dentro da cota do servidor."
	]
	quest.300000000000000B.quest_subtitle: "Open Parties and Claims"
	quest.300000000000000B.title: "Protecao de Base e Parties"
	quest.300000000000000C.quest_desc: [
		"Controles padrao do mapa:"
		"- &e[M]&r abre o Mapa Mundi completo com zoom e marcações."
		"- &e[B]&r cria um Waypoint rapido na sua posicao atual."
		"- &e[Y]&r abre as configuracoes do Xaero's Minimap para personalizar tamanho, radar e estilo."
	]
	quest.300000000000000C.quest_subtitle: "Xaero's Minimap e World Map"
	quest.300000000000000C.title: "Minimapa \\& Mapa Mundi"
	quest.300000000000000D.quest_desc: [
		"O modpack possui &bSimple Voice Chat&r configurado e ativo no servidor!"
		"- Aperte &e[V]&r no jogo para escolher microfone, ativar Push-to-Talk ou ativacao por voz, testar audio e criar salas de grupo."
		"- Quem esta perto no mundo ouve sua voz direcionalmente em 3D!"
	]
	quest.300000000000000D.quest_subtitle: "Simple Voice Chat — Tecla [V]"
	quest.300000000000000D.title: "Chat de Voz por Proximidade"
	quest.300000000000000E.quest_desc: [
		"&bCarry On&r: com as DUAS maos vazias, segure &eShift + Botao Direito&r em um bau, fornalha ou mob pequeno (porco, ovelha, galinha) para carrega-lo no colo!"
		""
		"&bTree Harvester&r: segure &eShift&r enquanto quebra o bloco base de uma arvore com um machado para derrubar todos os troncos e folhas de uma vez!"
	]
	quest.300000000000000E.quest_subtitle: "Carregue baus e corte arvores inteiras"
	quest.300000000000000E.title: "Mecanicas de Campo: Carry On \\& Tree Harvester"
	quest.300000000000000F.quest_desc: [
		"Atalhos e recursos essenciais do seu inventario:"
		"- &bEMI&r: pesquise qualquer item; &e[R]&r ve receita, &e[U]&r ve usos, &e[A]&r adiciona aos favoritos."
		"- &bTrashSlot&r: use o icone de lixeira na borda do inventario (ou &eDelete&r) para apagar lixo."
		"- &bEasy Anvils&r: itens continuam dentro da bigorna ao sair dela e permite formatar cores."
		"- &bArmor Statues&r: Shift + Botao Direito no Suporte de Armadura abre editor de poses."
		"- &bPotion Stacks&r: pocoes acumulam ate 16 no mesmo slot."
		"- &bCut Through&r: bata em mobs atraves de grama alta sem cortar o mato."
	]
	quest.300000000000000F.quest_subtitle: "EMI, TrashSlot, Easy Anvils, Armor Statues, Seamless Sleep"
	quest.300000000000000F.title: "Ferramentas de Inventario \\& Qualidade de Vida"
	quest.3000000000000010.quest_desc: [ "Combine &bAndesito&r com pepitas de Ferro ou Zinco na bancada — ou melhor ainda, no Misturador depois para render o dobro!" ]
	quest.3000000000000010.quest_subtitle: "Base de toda a era inicial do Create"
	quest.3000000000000010.title: "Liga de Andesito"
	quest.3000000000000011.quest_desc: [ "Shafts transmitem rotacao sem alterar velocidade nem direcao." ]
	quest.3000000000000011.quest_subtitle: "Transmitindo rotacao em linha reta"
	quest.3000000000000011.title: "Eixos (Shafts)"
	quest.3000000000000012.quest_desc: [ "Conecte uma Engrenagem Grande em uma Pequena para DOBRAR o RPM (reduzindo torque), ou o inverso para aumentar a forca!" ]
	quest.3000000000000012.quest_subtitle: "Alterando velocidade (RPM) e direcao"
	quest.3000000000000012.title: "Engrenagens Pequenas \\& Grandes"
	quest.3000000000000013.quest_desc: [ "Rotaciona blocos do Create, configura pistas/filtros e desmonta maquinas instantaneamente com &eShift + Botao Direito&r." ]
	quest.3000000000000013.quest_subtitle: "A ferramenta mais importante do engenheiro"
	quest.3000000000000013.title: "Chave Inglesa do Create"
	quest.3000000000000014.quest_desc: [ "Equipe no capacete para enxergar o estresse (SU), RPM, direcao de eixos e conteudo de tanques/tubos ao olhar para qualquer maquina." ]
	quest.3000000000000014.quest_subtitle: "Veja SU, RPM e fluidos nos blocos!"
	quest.3000000000000014.title: "Oculos de Engenheiro"
	quest.3000000000000015.quest_desc: [ "Gire manualmente para testar maquinas antes de montar geracao automatica." ]
	quest.3000000000000015.quest_subtitle: "Energia bruta com a forca do braco"
	quest.3000000000000015.title: "Manivela Manual"
	quest.3000000000000016.quest_desc: [ "Conduza água contra a Water Wheel e use um eixo para levar a rotação às máquinas. A versão grande é uma opção quando precisar de mais capacidade." ]
	quest.3000000000000016.quest_subtitle: "Sua primeira fonte contínua de rotação"
	quest.3000000000000016.title: "Energia hidráulica"
	quest.3000000000000017.quest_desc: [ "Quanto mais &bSails&r (velas) acopladas ao Windmill Bearing (ate 128 blocos), maior a energia (ate &a8192 SU&r)! Nao precisa nem usar Super Cola nas velas." ]
	quest.3000000000000017.quest_subtitle: "Engenharia eolica de alta capacidade"
	quest.3000000000000017.title: "Moinho de Vento"
	quest.3000000000000018.quest_desc: [ "Transforma trigo em farinha, ossos em farinha de osso com bonus e flores em mais corantes." ]
	quest.3000000000000018.quest_subtitle: "Moagem inicial de graos e minerios"
	quest.3000000000000018.title: "Moinho de Pedra (Millstone)"
	quest.3000000000000019.quest_desc: [
		"Coloque a prensa dois blocos acima de um Depot, deixando um bloco de ar entre eles. Ligue a prensa a uma fonte de rotação. Uma manivela já serve para o primeiro teste."
		"Ponha um lingote de cobre no Depot e recolha a chapa. Use chapas de cobre para fazer tubos e um tanque quando for montar a bomba."
		"O avanço é registrado quando a prensa processa um item. Coloque você mesmo a prensa para que o Create associe o avanço ao seu jogador."
	]
	quest.3000000000000019.quest_subtitle: "Teste a prensa no depósito"
	quest.3000000000000019.title: "A primeira chapa"
	quest.300000000000001A.quest_desc: [ "Junto a uma Basin abaixo, mistura ingredientes e dobra o rendimento da Liga de Andesito." ]
	quest.300000000000001A.quest_subtitle: "Receitas automatizadas e ligas"
	quest.300000000000001A.title: "Misturador Mecanico + Bacia"
	quest.300000000000001B.quest_desc: [ "Faça um Empty Blaze Burner e use-o em um Blaze ou no gerador de Blazes de uma fortaleza. Coloque o queimador sob uma bacia e dê combustível ao Blaze." ]
	quest.300000000000001B.quest_subtitle: "Calor para o misturador"
	quest.300000000000001B.title: "Capture um Blaze"
	quest.300000000000001C.quest_desc: [ "Assopre atraves de: &9Agua&r (lavar cascalho -> pepitas de ferro!), &6Fogo&r (defumar), &cLava&r (fundir stacks sem carvao!) ou &5Fogo das Almas&r (assombrar)." ]
	quest.300000000000001C.quest_subtitle: "Lavar, defumar, fundir e assombrar em massa"
	quest.300000000000001C.title: "Ventilador Encaixotado"
	quest.300000000000001D.quest_desc: [
		"Ponha dois eixos paralelos na mesma altura e use um Belt Connector no primeiro e depois no segundo. Ligue um deles à rotação para mover a esteira."
		"Passe a esteira por baixo da prensa para que os lingotes cheguem sozinhos."
	]
	quest.300000000000001D.quest_subtitle: "Conecte dois eixos para transportar uma carga"
	quest.300000000000001D.title: "Leve itens pela esteira"
	quest.300000000000001E.quest_desc: [
		"Faça dois funis de andesito. Um tira lingotes do baú de entrada e o outro recolhe chapas no baú de saída."
		"Confira as setas e use a chave inglesa para inverter o sentido. O Ponder dos funis mostra como encaixá-los nos baús junto à esteira."
	]
	quest.300000000000001E.quest_subtitle: "Dois funis conectam os baús à esteira"
	quest.300000000000001E.title: "Uma entrada e uma saída"
	quest.300000000000001F.quest_desc: [ "Experimente uma serra para madeira ou uma colhedora em uma estrutura móvel. Use broca e arado conforme a fazenda precisar." ]
	quest.300000000000001F.quest_subtitle: "Serra e colhedora"
	quest.300000000000001F.title: "Colheita mecânica"
	quest.3000000000000020.quest_desc: [
		"Use as chapas de cobre da prensa para fabricar tubos e um tanque. As receitas aparecem no EMI."
		"Gire a bomba e confira o sentido com a chave. Ligue o tanque às máquinas com Fluid Pipes. Spout, Item Drain e Hose Pulley servem para transferências mais específicas."
	]
	quest.3000000000000020.quest_subtitle: "Bomba, tubulação e tanque"
	quest.3000000000000020.title: "Bombeie e armazene fluidos"
	quest.3000000000000021.quest_desc: [ "Encha o Backtank conectado a um eixo rotativo e use com o Capacete de Mergulho!" ]
	quest.3000000000000021.quest_subtitle: "Respire indefinidamente debaixo d'agua ou na lava"
	quest.3000000000000021.title: "Equipamento de Mergulho de Cobre"
	quest.3000000000000022.quest_desc: [ "Cole os blocos da estrutura com Super Glue e monte-os em um Mechanical Bearing. A contraption gira sem mover o motor." ]
	quest.3000000000000022.quest_subtitle: "Cola e rolamento mecânico"
	quest.3000000000000022.title: "Sua primeira máquina móvel"
	quest.3000000000000023.quest_desc: [ "Use Elevator Pulley com contatos de redstone nos andares. Rope Pulley faz uma plataforma mais simples. A Schematicannon fica disponível como ferramenta de construção." ]
	quest.3000000000000023.quest_subtitle: "Transporte vertical"
	quest.3000000000000023.title: "Elevador mecânico"
	quest.3000000000000024.quest_desc: [ "Combine Quartzo do Nether com Redstone para criar Rose Quartz, depois lixe com Lixa (Sand Paper)." ]
	quest.3000000000000024.quest_subtitle: "Circuitos analogicos do Create"
	quest.3000000000000024.title: "Quartzo Rosa Polido \\& Tubo de Eletrons"
	quest.3000000000000025.quest_desc: [ "Aqueça &bCobre + Zinco&r na Basin usando um Blaze Burner!" ]
	quest.3000000000000025.quest_subtitle: "Mistura aquecida e carcaça de latão"
	quest.3000000000000025.title: "Primeiro latão"
	quest.3000000000000026.quest_desc: [ "Use a Brass Hand na receita do Deployer. Depois alimente a máquina com rotação e dê a ela o item que deve aplicar durante a montagem." ]
	quest.3000000000000026.quest_subtitle: "Automatize a montagem e o uso de itens"
	quest.3000000000000026.title: "Deployer"
	quest.3000000000000027.quest_desc: [ "Montagem sequencial (5 ciclos): Prensa + Engrenagem Pequena + Engrenagem Grande + Pepita de Ferro sobre uma Chapa de Ouro!" ]
	quest.3000000000000027.quest_subtitle: "O coracao das maquinas avancadas"
	quest.3000000000000027.title: "Mecanismo de Precisao"
	quest.3000000000000028.quest_desc: [ "Monte a receita em Mechanical Crafters. Instale as duas rodas lado a lado girando em sentidos opostos e alimente a abertura entre elas." ]
	quest.3000000000000028.quest_subtitle: "Um par de rodas de trituração"
	quest.3000000000000028.title: "Trituração em escala"
	quest.3000000000000029.quest_desc: [ "Com uma Large Cogwheel encaixada acima, defina exatamente de -256 a +256 RPM com um clique!" ]
	quest.3000000000000029.quest_subtitle: "Ajuste fino de RPM (1 a 256) e bracos roboticos"
	quest.3000000000000029.title: "Controlador de Velocidade \\& Braco Mecanico"
	quest.300000000000002A.quest_desc: [ "Filtre a entrada e a saída com Brass Funnel e Smart Chute. O Content Observer emite um sinal ao detectar itens no inventário configurado." ]
	quest.300000000000002A.quest_subtitle: "Seleção de itens e sinais de inventário"
	quest.300000000000002A.title: "Logística com filtro"
	quest.300000000000002B.quest_desc: [ "Empilhe Fluid Tanks, bombeie agua constante, coloque Blaze Burners embaixo e conecte &bSteam Engines&r aos tanques!" ]
	quest.300000000000002B.quest_subtitle: "Energia cinetica colossal (ate 294.912 SU!)"
	quest.300000000000002B.title: "Motor a Vapor Industrial"
	quest.300000000000002C.quest_desc: [ "Estenda os trilhos e use a estação para montar um trem com bogies e controles. Sinais e horários entram quando houver mais estações ou composições." ]
	quest.300000000000002C.quest_subtitle: "Trilhos, estação e controles"
	quest.300000000000002C.title: "Primeiro trem"
	quest.300000000000002D.quest_desc: [ "O Packager transforma itens do inventário em pacotes. Configure o endereço do Frogport e use esteiras ou correntes para levar as caixas ao destino." ]
	quest.300000000000002D.quest_subtitle: "Embale, enderece e receba"
	quest.300000000000002D.title: "Envie seus primeiros pacotes"
	quest.300000000000002E.quest_desc: [ "Monte um Stock Link com um Packager e conecte-o à rede do Stock Ticker. Use correntes para o transporte das caixas e adicione o Redstone Requester quando precisar automatizar pedidos." ]
	quest.300000000000002E.quest_subtitle: "Ligue inventários e peça itens a distância"
	quest.300000000000002E.title: "Rede de estoque"
	quest.300000000000002F.quest_desc: [ "Construa um &bConductor&r com o bone, ou atravesse os trilhos pedalando um &bHandcar&r! O addon &eThreaded Trains&r acelera todo o servidor." ]
	quest.300000000000002F.quest_subtitle: "Bone de condutor, apito e vagoneta manual"
	quest.300000000000002F.title: "Steam 'n' Rails: Condutores e Handcar"
	quest.3000000000000030.quest_desc: [ "Instale um Track Coupler para separar composições. Use Semaphore para exibir a indicação de um sinal de trem." ]
	quest.3000000000000030.quest_subtitle: "Acoplamento e sinalização"
	quest.3000000000000030.title: "Controle ferroviário"
	quest.3000000000000031.quest_desc: [ "Coloque um Benchcart no trilho para levar passageiros. O Steam ’n’ Rails também oferece carrinhos e acessórios temáticos." ]
	quest.3000000000000031.quest_subtitle: "Transporte de passageiros"
	quest.3000000000000031.title: "Banco sobre trilhos"
	quest.3000000000000032.quest_desc: [ "Consulte destinos e horários no Navigator. Configure o Advanced Display Panel para anunciar a estação e as próximas partidas." ]
	quest.3000000000000032.quest_subtitle: "Navegador e painel"
	quest.3000000000000032.title: "Informação ao passageiro"
	quest.3000000000000033.quest_desc: [ "Monte um farol e um anteparo na composição já planejada. Outras formas e acabamentos aparecem como opções do Bells \\& Whistles." ]
	quest.3000000000000033.quest_subtitle: "Farol e anteparo"
	quest.3000000000000033.title: "Detalhes da locomotiva"
	quest.3000000000000035.quest_desc: [ "Fabrique a versão vazia e instale a carga indicada no EMI ou no Ponder. Consulte as regras do servidor antes de manter máquinas e áreas carregadas." ]
	quest.3000000000000035.quest_subtitle: "Prepare um carregador de andesito"
	quest.3000000000000035.title: "Carregamento de chunks"
	quest.3000000000000036.quest_desc: [ "Configure Logic Gauge e Counter Gauge junto a uma linha de produção. Sensores de voo ficam na trilha de aeronáutica." ]
	quest.3000000000000036.quest_subtitle: "Lógica e contagem"
	quest.3000000000000036.title: "Medidores de automação"
	quest.3000000000000037.quest_desc: [ "Monte a placa e conecte o monitor para acompanhar circuitos. Power Chip é uma opção separada para transportar lógica." ]
	quest.3000000000000037.quest_subtitle: "Placa e monitor"
	quest.3000000000000037.title: "Circuitos de redstone"
	quest.3000000000000038.quest_desc: [ "Use a Brass Gearbox para rotear eixos. Teste a Inverted Clutch com redstone para controlar um ramal da fábrica." ]
	quest.3000000000000038.quest_subtitle: "Caixa de engrenagens e embreagem invertida"
	quest.3000000000000038.title: "Transmissões de latão"
	quest.3000000000000039.quest_desc: [ "Configure o Shuffle Filter para escolher materiais durante a construção. Consulte no EMI ferramentas de alcance ou esquemas de padrões." ]
	quest.3000000000000039.quest_subtitle: "Use o Shuffle Filter na construção"
	quest.3000000000000039.title: "Filtro de seleções"
	quest.300000000000003A.quest_desc: [ "Confira a receita no EMI. A Compression Gun exige uma Precision Mechanism, uma Sturdy Sheet e Levitite Blend. Use o Ponder antes de compactar uma estrutura." ]
	quest.300000000000003A.quest_subtitle: "Compression Gun"
	quest.300000000000003A.title: "Contraptions portáteis"
	quest.300000000000003B.quest_desc: [ "Prepare a bacia e o armazenamento de líquidos. Nas etapas seguintes você vai extrair petróleo e processá-lo na coluna de destilação." ]
	quest.300000000000003B.quest_subtitle: "Tampa de bacia e barril"
	quest.300000000000003B.title: "Comece com combustíveis"
	quest.300000000000003C.quest_desc: [ "Use o Detector de Petroleo ou localize chunks ricos em petroleo bruto e monte sua torre Pumpjack ligada a canos!" ]
	quest.300000000000003C.quest_subtitle: "Perfure o subsolo por jazidas de petroleo"
	quest.300000000000003C.title: "Extracao de Petroleo Bruto (Pumpjack)"
	quest.300000000000003D.quest_desc: [ "Aplique sobre Fluid Tanks aquecidos por Blaze Burners para separar Petroleo em Fracoes Leves (Gasolina) e Pesadas (Diesel)." ]
	quest.300000000000003D.quest_subtitle: "Refine Petroleo em Gasolina e Diesel"
	quest.300000000000003D.title: "Torre de Destilacao"
	quest.300000000000003E.quest_desc: [ "Abasteça um Diesel Engine com combustível da destilação. Suba para versões maiores quando sua rede precisar de mais potência." ]
	quest.300000000000003E.quest_subtitle: "Converta combustível em rotação"
	quest.300000000000003E.title: "Motor a diesel"
	quest.300000000000003F.quest_desc: [ "Power Grid traz eletricidade realista (Volts, Amperes e Ohms) para dentro do Create! Cuidado com curtos e sobrecarga de fios." ]
