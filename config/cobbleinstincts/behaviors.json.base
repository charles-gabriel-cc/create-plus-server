    {
      "id": "retaliate",
      "enabled": true,
      "species": [
        "psyduck"
      ],
      "priority": 3,
      "params": {
        "effect": "psychic",
        "escapeBelowLevel": 30,
        "burstHealth": 0.3,
        "headacheHits": 4,
        "heavyHitFraction": 0.35,
        "fleeHealth": 0.2,
        "fleeDelayTicks": 15,
        "warnNauseaTicks": 60,
        "chance": 1.0,
