        "perf": "light",
        "wildOnly": false,
        "searchRange": 20.0,
        "speed": 0.9,
        "cooldownTicks": 80,
        "minSpeed": 0.55,
        "maxSpeed": 1.1,
        "accelerationTicks": 30,
        "speedMode": "speed_stat",
        "speedStatRef": 200.0
      }
    },
